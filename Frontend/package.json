{
  "name": "voyage-travel-agent",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc --noEmit && vite build --config vite.config.ts",
    "lint": "tsc --noEmit && prettier --check src vite.config.ts index.html",
    "format": "prettier --write src vite.config.ts index.html",
    "preview": "vite preview --config vite.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.358.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.2.2",
    "vite": "^7.3.7"
  }
}
