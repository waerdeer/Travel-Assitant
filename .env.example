# Copy to Backend/.env. Never put real keys in this tracked example file.
AMAP_MAPS_API_KEY=your_amap_web_service_key
LLM_API_KEY=your_model_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Leave empty to use Backend/travel_assistant.db regardless of working directory.
DATABASE_URL=
LLM_TIMEOUT_SECONDS=90
AGENT_TIMEOUT_SECONDS=300
MAX_PLAN_REPAIRS=2
MAX_TOOL_CALLS=24
MCP_MIN_INTERVAL_SECONDS=1.05
MCP_STRICT_STARTUP=false
